# ==============================================================================
# SOURCEWISE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your actual .env file or credentials to Git.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Force Demo Mode (true | false). When true, deterministic generation is always used.
# Even when false, if no LLM key is configured, the app safely defaults to Demo Mode.
FORCE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string:
# Direct URI (Transaction Pooler or Direct):
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@[host]:6543/postgres?sslmode=require
# Or standard postgresql:// (handled transparently by the database connector)
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Optional pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# OPTIONAL AI PROVIDER CREDENTIALS (CONNECTED MODE)
# If left blank, SourceWise AI runs in 100% functional, deterministic Demo Mode.
# No purchase or API key is required for full assessment functionality.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Preferred AI Model (when Connected Mode is active)
AI_MODEL_NAME=gpt-4o-mini
