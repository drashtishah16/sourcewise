# ==============================================================================
# SOURCEWISE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your actual .env file or credentials to Git.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Force Demo Mode (true | false). When true, deterministic generation is always used.
# Even when false, if no LLM key is configured, the app safely defaults to Demo Mode.
FORCE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# SQLITE DATABASE CONFIGURATION (DEFAULT)
# ------------------------------------------------------------------------------
# By default, SourceWise AI automatically uses a local persistent SQLite database
# stored at 'data/sourcewise.db' relative to the project root.
# Foreign key enforcement (PRAGMA foreign_keys = ON) is enabled automatically.
# You do NOT need to configure DATABASE_URL or install external database servers.
DATABASE_PATH=data/sourcewise.db

# Alternatively, configure via DATABASE_URL:
# DATABASE_URL=sqlite:///data/sourcewise.db

# To disable database persistence and run in ephemeral session-only memory:
# DISABLE_DATABASE=false

# ------------------------------------------------------------------------------
# OPTIONAL AI PROVIDER CREDENTIALS (CONNECTED MODE)
# If left blank, SourceWise AI runs in 100% functional, deterministic Demo Mode.
# No purchase or API key is required for full assessment functionality.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Preferred AI Model (when Connected Mode is active)
AI_MODEL_NAME=gpt-4o-mini
